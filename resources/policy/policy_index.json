  "violation_taxonomy": {
    "RB-01": {
      "name": "table-level violation",
      "definition": "The query references a table/relation outside the role permission scope."
    },
    "RB-02": {
      "name": "column-level violation",
      "definition": "The query references a denied or non-permitted column within an otherwise permitted relation."
    },
    "RB-03": {
      "name": "row/scope-level violation",
      "definition": "The query lacks or exceeds the required ownership, enrollment, or assignment row filter."
    }
