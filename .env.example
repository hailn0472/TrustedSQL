TRUSTEDSQL_VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_PROJECT_ID=your-gcp-project-id
TRUSTEDSQL_VERTEX_LOCATION=global
VERTEX_LOCATION=global
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
TRUSTEDSQL_DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database
TRUSTEDSQL_PROJECT_ROOT=path/to/trustedsql

# FCI / FPT AI Factory OpenAI-compatible endpoint
# Provider profiles are selected in configs/experiments/*.yaml.
# fci_oss20b.yaml reads FPT_API_KEY_20B; fci_oss120b.yaml reads FPT_API_KEY_120B.
FPT_API_KEY_20B=your-fpt-ai-factory-20b-key
FPT_API_KEY_120B=your-fpt-ai-factory-120b-key
TRUSTEDSQL_FCI_API_URL=https://mkp-api.fptcloud.com/chat/completions
