# API Keys
GOOGLE_API_KEY=your_google_api_key_here

# Database (SQL Server)
DATABASE_URI=mssql+pyodbc://username:password@server:port/database?driver=ODBC+Driver+17+for+SQL+Server

# File Search Store
# Create a File Search Store using: python scripts/manage_file_search_stores.py create <display_name>
# Then copy the store ID (e.g., fileSearchStores/abc123) here
FILE_SEARCH_STORE_NAME=fileSearchStores/your_store_id_here

# LLM
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1e-3

# Checkpointer
CHECKPOINT_DB_PATH=data/checkpoints.db

# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
# python -c "import secrets; print(secrets.token_hex(24))" to create SECRET_KEY

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24